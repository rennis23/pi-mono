#!/bin/sh

set -u

run_required() {
	label=$*
	echo "Running $label..."
	if ! "$@"; then
		echo "❌ $label failed. Push aborted."
		exit 1
	fi
}

run_required npm test
run_required npm run security:packages
run_required npm run security:audit
run_required npm run mutation:changed

if command -v codeql >/dev/null 2>&1; then
	run_required npm run security:codeql
else
	echo "CodeQL CLI not found; skipping optional local CodeQL pre-push check."
	echo "Install CodeQL to run it locally; the pull-request CI CodeQL job remains authoritative."
fi

echo "All pre-push checks passed."
