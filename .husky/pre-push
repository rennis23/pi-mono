#!/bin/sh

echo "Running test suite before push..."
npm run test
if [ $? -ne 0 ]; then
  echo "Tests failed. Push aborted."
  exit 1
fi

echo "Tests passed."

echo "Running mutation tests before push (Stryker; this takes a while)..."
npm run mutation:changed
if [ $? -ne 0 ]; then
  echo "❌ Mutation score is below the break threshold. Push aborted."
  echo "   Inspect reports/mutation/mutation.html, or bypass with: git push --no-verify"
  exit 1
fi

echo "Mutation tests passed."
