{
	"name": "@rennis23/mx-pi-settings",
	"version": "0.1.0",
	"description": "Pi extension. Central settings hub every mx-pi extension can register its own options with, edited from one TUI screen and one config file.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"settings",
		"configuration",
		"tui"
	],
	"type": "module",
	"license": "MIT",
	"author": "rennis23",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rennis23/pi-mono.git",
		"directory": "packages/mx-pi-settings"
	},
	"homepage": "https://github.com/rennis23/pi-mono/tree/master/packages/mx-pi-settings#readme",
	"bugs": {
		"url": "https://github.com/rennis23/pi-mono/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run"
	},
	"files": [
		"index.ts",
		"sdk.ts",
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"!test/**",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"SECURITY.md"
	],
	"exports": {
		".": {
			"types": "./sdk.ts",
			"default": "./sdk.ts"
		},
		"./sdk": {
			"types": "./sdk.ts",
			"default": "./sdk.ts"
		},
		"./extension": {
			"types": "./index.ts",
			"default": "./index.ts"
		}
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.0",
		"@earendil-works/pi-tui": ">=0.80.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.0.3",
		"@earendil-works/pi-tui": "^1.0.3"
	}
}
