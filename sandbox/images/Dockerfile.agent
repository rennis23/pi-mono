# pi-coding-agent sandbox image (arm64 Linux guest on Apple Silicon)
FROM docker.io/library/node:22-alpine

RUN apk add --no-cache \
		bash \
		bat \
		ca-certificates \
		curl \
		fd \
		git \
		github-cli \
		openssh-client \
		ripgrep

# pi-coding-agent + pi package manager
RUN npm install -g @earendil-works/pi-coding-agent

# Non-root user for the agent session. UID/GID 501 matches the default macOS
# user so mounted host dirs (e.g. /workspace) stay writable in the guest.
RUN addgroup -g 501 agent \
	&& adduser -D -u 501 -G agent -h /home/agent agent \
	&& mkdir -p /workspace \
	&& chown agent:agent /workspace

USER agent
WORKDIR /workspace

# Pre-cache the extensions listed in sandbox/pi-global/settings.json (packages key).
# This file is also mounted at runtime as the guest pi settings, so the build-time
# install list and runtime load list are always the same.
COPY pi-global/settings.json /tmp/pi-settings.json
RUN node -e ' \
	const { execFileSync } = require("child_process"); \
	const settings = require("/tmp/pi-settings.json"); \
	for (const pkg of settings.packages || []) { \
		execFileSync("pi", ["install", pkg], { stdio: "inherit" }); \
	} \
'

ENTRYPOINT ["pi"]
